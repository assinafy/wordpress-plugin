{
	"$schema": "https://schemas.wp.org/trunk/wp-env.json",
	"core": null,
	"phpVersion": "8.2",
	"port": 8888,
	"testsPort": 8889,
	"mappings": {
		"wp-content/plugins/assinafy": "."
	},
	"config": {
		"WP_DEBUG": true,
		"WP_DEBUG_LOG": true,
		"WP_DEBUG_DISPLAY": false,
		"SCRIPT_DEBUG": true
	},
	"lifecycleScripts": {
		"afterStart": "wp-env run cli wp plugin activate assinafy && wp-env run tests-cli wp plugin activate assinafy"
	},
	"plugins": [
		"https://downloads.wordpress.org/plugin/woocommerce.latest-stable.zip"
	]
}
