#: src/Integrations/WooCommerceProductTab.php:89
msgid "Send for signature"
msgstr "Enviar para assinatura"

#: src/Admin/SendScreen.php:125 src/Admin/SendScreen.php:167
msgid "Choose a PDF"
msgstr "Escolher um PDF"

#: src/Admin/SendScreen.php:126
msgid "Use this PDF"
msgstr "Usar este PDF"

#: src/Admin/SendScreen.php:127
msgid "Choose a PDF file."
msgstr "Escolha um arquivo PDF."

#: src/Admin/SendScreen.php:128
msgid "Enter a valid email address for every signer."
msgstr "Informe um e-mail válido para cada signatário."

#: src/Admin/SendScreen.php:129
msgid "Each signer must have a different email address."
msgstr "Cada signatário deve ter um endereço de e-mail diferente."

#: src/Admin/SendScreen.php:140 src/Admin/SendScreen.php:304
msgid "You are not allowed to send documents for signature."
msgstr "Você não tem permissão para enviar documentos para assinatura."

