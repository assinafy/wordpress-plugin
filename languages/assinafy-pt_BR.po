#: src/Documents/DownloadProxy.php:129
msgid "You are not allowed to download this document."
msgstr "Você não tem permissão para baixar este documento."

#: src/Documents/DownloadProxy.php:130
msgid "Forbidden"
msgstr "Acesso negado"

#: src/Documents/DownloadProxy.php:216
msgid "That document is not available for download."
msgstr "Esse documento não está disponível para download."

#: src/Documents/DownloadProxy.php:217
