#. Plugin Name of the plugin
#. Author of the plugin
#: assinafy.php src/Integrations/ElementorAction.php:59 src/Settings.php:210
#: src/Settings.php:211 src/Settings.php:327
msgid "Assinafy"
msgstr "Assinafy"

#. Plugin URI of the plugin
#: assinafy.php
msgid "https://github.com/assinafy/wordpress-plugin"
msgstr ""

#. Description of the plugin
#: assinafy.php
msgid ""
"Send WordPress documents for electronic signature with Assinafy and track "
"them to completion."
msgstr ""
"Envie documentos do WordPress para assinatura eletrônica com o Assinafy e "
"acompanhe-os até a conclusão."

#. Author URI of the plugin
#: assinafy.php
msgid "https://www.assinafy.com.br/"
msgstr ""

#. translators: 1: required PHP version, 2: current PHP version.
#: assinafy.php:44
#, php-format
msgid "Assinafy requires PHP %1$s or newer. This site runs PHP %2$s."
msgstr "O Assinafy exige PHP %1$s ou mais recente. Este site usa PHP %2$s."

#: assinafy.php:75
msgid ""
"Assinafy could not load its dependencies. Reinstall the plugin from a "
"complete package."
msgstr ""
"O Assinafy não conseguiu carregar suas dependências. Reinstale o plugin a "
"partir de um pacote completo."

