msgstr "Não encontrado"

#: src/Documents/SendAttempt.php:120
msgid ""
"Signers must be unique, and their signing steps must start at 1 without gaps."
msgstr ""
"Os signatários não podem se repetir, e as etapas de assinatura devem começar "
"em 1, sem pular números."

#: src/Documents/SendAttempt.php:125
msgid "A digital certificate signer must have a signing step of their own."
msgstr ""
"O signatário que utiliza certificado digital deve ter uma etapa de "
"assinatura exclusiva."

#: src/Documents/SendAttempt.php:154
msgid ""
"The uploaded document id could not be saved. Check the Assinafy account "
"before retrying."
msgstr ""
"O ID do documento enviado não pôde ser salvo. Confira a conta do Assinafy "
"antes de tentar novamente."

#: src/Documents/SendAttempt.php:178
msgid ""
"Assinafy returned no assignment id. Retry to check whether signatures were "
"requested."
msgstr ""
"O Assinafy não retornou o ID da solicitação de assinatura. Tente novamente "
"para verificar se as assinaturas foram solicitadas."

#: src/Documents/SendAttempt.php:211
msgid "Assinafy returned no valid signer id."
msgstr "O Assinafy não retornou um ID de signatário válido."

#: src/Documents/SendAttempt.php:230
msgid ""
"The previous upload outcome is unknown. Check the Assinafy account before "
"starting a new send with a new idempotency key."
msgstr ""
"O resultado do envio anterior é desconhecido. Confira a conta do Assinafy "
"antes de iniciar um novo envio com uma nova chave de idempotência."

#: src/Documents/SendAttempt.php:250
msgid ""
"This record already mirrors a document. Start a new send without post_id to "
"keep its signature history."
msgstr ""
"Este registro já corresponde a um documento. Inicie um novo envio sem "
"post_id para preservar o histórico de assinaturas."

#: src/Documents/SendAttempt.php:264
msgid "The local document record could not be created. Nothing was uploaded."
msgstr ""
"O registro local do documento não pôde ser criado. Nenhum arquivo foi "
"enviado."

#: src/Documents/SendAttempt.php:270
msgid "The integration source could not be saved. Nothing was uploaded."
msgstr "A origem da integração não pôde ser salva. Nenhum arquivo foi enviado."

#: src/Documents/SendAttempt.php:275
msgid "The send reservation could not be saved. Nothing was uploaded."
msgstr "A reserva do envio não pôde ser salva. Nenhum arquivo foi enviado."

#: src/Documents/SendAttempt.php:289
msgid ""
"Upload returned no valid document id. Check the Assinafy account before "
"retrying."
msgstr ""
"O envio não retornou um ID de documento válido. Confira a conta do Assinafy "
"antes de tentar novamente."

#: src/Documents/SendService.php:173
msgid "Add an Assinafy API key and account id before sending a document."
msgstr ""
"Adicione uma chave de API e um ID da conta Assinafy antes de enviar um "
"documento."

#: src/Documents/SendService.php:269
msgid "The signature deadline must be a valid date in the future."
msgstr "O prazo de assinatura deve ser uma data válida no futuro."

#: src/Documents/SendService.php:323
msgid ""
"This document is already being sent. Wait for the first attempt to finish."
msgstr ""
"Este documento já está sendo enviado. Aguarde a primeira tentativa terminar."

#: src/Documents/SendService.php:345
msgid "Only PDF attachments can be sent for signature."
msgstr "Somente anexos em PDF podem ser enviados para assinatura."

#: src/Documents/SendService.php:356
msgid "The selected attachment has no file on disk."
msgstr "O anexo selecionado não tem arquivo em disco."

#: src/Documents/SendService.php:368
msgid "Choose a PDF to send: pass either attachment_id or file_path."
msgstr "Escolha um PDF para enviar: informe attachment_id ou file_path."

#: src/Documents/Signers.php:50
msgid "Every signer must be a complete signer row."
msgstr "Cada signatário deve ter um registro completo."

#: src/Documents/Signers.php:70
msgid "Add at least one signer."
msgstr "Adicione pelo menos um signatário."

#: src/Documents/Signers.php:135
msgid "Signer steps must be positive whole numbers."
msgstr "As etapas de assinatura devem ser números inteiros positivos."

#: src/Documents/Signers.php:155
msgid "Every signer field must contain text."
msgstr "Todos os campos do signatário devem conter texto."

#: src/Documents/Signers.php:174
msgid "The signer id is not valid."
msgstr "O ID do signatário não é válido."

#: src/Documents/Signers.php:179
msgid ""
"The selected verification method requires matching contact details, or an "
"existing signer id for digital certificates."
msgstr ""
"O método de verificação selecionado exige os dados de contato "
"correspondentes ou, no caso de certificados digitais, o ID de um signatário "
"existente."

#: src/Documents/Signers.php:204
msgid "Every signer needs a name."
msgstr "Todo signatário precisa de um nome."

#: src/Documents/Signers.php:213
msgid "One of the signer email addresses is not valid."
msgstr "Um dos e-mails de signatário não é válido."

#: src/Documents/Signers.php:220
msgid "Every signer needs an email address or a WhatsApp number."
msgstr "Todo signatário precisa de um e-mail ou de um número de WhatsApp."

#: src/Documents/Signers.php:243
msgid ""
"The signer notification channel must match its verification method; digital "
"certificates support Email or Whatsapp."
msgstr ""
"O canal de notificação do signatário deve corresponder ao método de "
"verificação; certificados digitais permitem e-mail ou WhatsApp."

#: src/Documents/SourceReference.php:45
msgid ""
"The integration source must contain a valid integration slug and record id."
msgstr ""
