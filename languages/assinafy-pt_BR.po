#: src/Documents/DocumentPostType.php:250
#: src/Integrations/WooCommerceProductTab.php:98 src/Privacy.php:152
msgid "Document"
msgstr "Documento"

#: src/Admin/SendScreen.php:165
msgid "No PDF chosen"
msgstr "Nenhum PDF escolhido"

#: src/Admin/SendScreen.php:170
msgid ""
"Pick a PDF already in the media library, or upload one from the chooser. "
"Files up to 25 MB are accepted."
msgstr ""
"Escolha um PDF que já esteja na biblioteca de mídia ou envie um pelo "
"seletor. São aceitos arquivos de até 25 MB."

#: src/Admin/SendScreen.php:181
msgid "Name"
msgstr "Nome"

#: src/Admin/SendScreen.php:182
msgid "Email"
msgstr "E-mail"

#: src/Admin/SendScreen.php:183
msgid "WhatsApp (optional)"
msgstr "WhatsApp (opcional)"

#: src/Admin/SendScreen.php:194
msgid "Add another signer"
msgstr "Adicionar outro signatário"

#: src/Admin/SendScreen.php:198
msgid ""
"Signers sharing an order number are invited at the same time. A higher "
"number is invited only once every lower number has signed. Leave the column "
"at 1 to invite everyone at once."
msgstr ""
"Signatários com o mesmo número de ordem são convidados ao mesmo tempo. Um "
"número maior só é convidado depois que todos os números menores assinarem. "
"Deixe a coluna em 1 para convidar todos de uma vez."

#: src/Admin/SendScreen.php:205 src/Settings.php:516
msgid "Message to signers"
msgstr "Mensagem aos signatários"

#: src/Admin/SendScreen.php:215 src/Settings.php:504
msgid "Signature deadline"
msgstr "Prazo de assinatura"

#: src/Admin/SendScreen.php:222
msgid ""
"Signers can no longer sign after the end of this day (UTC). Leave the field "
"blank to use the deadline set on the settings screen."
msgstr ""
"Os signatários não poderão mais assinar depois do fim deste dia (UTC). Deixe "
"o campo em branco para usar o prazo definido na tela de configurações."

#: src/Admin/SendScreen.php:229
msgid ""
"Sending consumes one document from your Assinafy balance. Email invitations "
"cost no credits. If the balance is short, the request is refused before "
"anything is uploaded."
msgstr ""
"O envio consome um documento do seu saldo Assinafy. Convites por e-mail não "
"custam créditos. Se o saldo for insuficiente, a solicitação é recusada antes "
"de qualquer arquivo ser enviado."

#: src/Admin/SendScreen.php:253 src/Privacy.php:164
msgid "Signer name"
msgstr "Nome do signatário"

#: src/Admin/SendScreen.php:261 src/Privacy.php:168
msgid "Signer email"
msgstr "E-mail do signatário"

#: src/Admin/SendScreen.php:269
msgid "Signer WhatsApp number"
msgstr "Número de WhatsApp do signatário"

#: src/Admin/SendScreen.php:277 src/Privacy.php:172
msgid "Signing order"
msgstr "Ordem de assinatura"

#: src/Admin/SendScreen.php:285
msgid "Remove"
msgstr "Remover"

#. translators: %s: reason the send was refused.
#: src/Admin/SendScreen.php:320
#, php-format
msgid "The document was not sent: %s"
msgstr "O documento não foi enviado: %s"

#: src/Admin/SendScreen.php:326
msgid "Sent. Signers have been invited by email."
msgstr "Enviado. Os signatários foram convidados por e-mail."

#: src/Admin/SendScreen.php:367
msgid "Choose a signature deadline in the future."
msgstr "Escolha um prazo de assinatura no futuro."

#: src/Admin/SendScreen.php:406
msgid "Choose a PDF to send."
msgstr "Escolha um PDF para enviar."

#: src/Admin/SendScreen.php:412
msgid "That file is no longer in the media library."
msgstr "Esse arquivo não está mais na biblioteca de mídia."

#: src/Admin/SendScreen.php:416
msgid "Assinafy signs PDF files only. Choose a PDF."
msgstr "O Assinafy assina somente arquivos PDF. Escolha um PDF."

#: src/Admin/SendScreen.php:420
msgid "You are not allowed to use that file."
msgstr "Você não tem permissão para usar esse arquivo."

#: src/Admin/SendScreen.php:443
msgid "Add a name and a valid, unique email address for every signer."
msgstr ""
"Informe um nome e um endereço de e-mail válido e exclusivo para cada "
"signatário."

#: src/Admin/SettingsAjax.php:71
msgid "Enter an account id and an API key first."
msgstr "Informe primeiro um ID da conta e uma chave de API."

#. translators: %s: Assinafy account name.
#: src/Admin/SettingsAjax.php:102
#, php-format
msgid "Connected to %s."
msgstr "Conectado a %s."

#: src/Admin/SettingsAjax.php:103
msgid "your account"
msgstr "sua conta"

#: src/Admin/SettingsAjax.php:127
msgid "Connect the plugin to Assinafy before registering the webhook."
msgstr "Conecte o plugin ao Assinafy antes de registrar o webhook."

#: src/Admin/SettingsAjax.php:151
msgid ""
"Webhook registered. Assinafy will notify this site as documents progress."
msgstr ""
"Webhook registrado. O Assinafy notificará este site conforme os documentos "
"avançarem."

#. translators: %s: currently registered webhook URL.
#: src/Admin/SettingsAjax.php:177
#, php-format
msgid ""
"This Assinafy account already delivers webhooks to %s. Registering this site "
"replaces that subscription."
msgstr ""
"Esta conta Assinafy já entrega webhooks em %s. Registrar este site substitui "
"essa inscrição."

#: src/Credentials.php:132
msgid ""
"The stored Assinafy API key was written by a different version of this "
"plugin and cannot be read. Enter the key again."
msgstr ""
"A chave de API do Assinafy armazenada foi gravada por outra versão deste "
"plugin e não pode ser lida. Informe a chave novamente."

#: src/Credentials.php:189
msgid ""
"The stored Assinafy API key could not be decrypted. This happens when the "
"site security salts change. Enter the key again."
msgstr ""
"Não foi possível descriptografar a chave de API do Assinafy armazenada. Isso "
"acontece quando os salts de segurança do site mudam. Informe a chave "
"novamente."

#: src/Documents/CostEstimate.php:95 src/Documents/StatusSync.php:178
msgid "Assinafy is not configured."
msgstr "O Assinafy não está configurado."

#: src/Documents/CostEstimate.php:171
msgid ""
"The Assinafy account has a payment outstanding. Settle it to send documents "
"again."
msgstr ""
"A conta Assinafy tem um pagamento em aberto. Regularize-o para voltar a "
"enviar documentos."

#: src/Documents/CostEstimate.php:172
msgid "The Assinafy account has no document allowance left on its plan."
msgstr "A conta Assinafy não tem mais documentos disponíveis no plano."

#: src/Documents/CostEstimate.php:173
msgid ""
"The Assinafy account does not have enough credits for the selected "
"notification method."
msgstr ""
"A conta Assinafy não tem créditos suficientes para a forma de notificação "
"selecionada."

#: src/Documents/CostEstimate.php:176
msgid "The Assinafy account cannot cover this signature request."
msgstr "A conta Assinafy não consegue cobrir esta solicitação de assinatura."

