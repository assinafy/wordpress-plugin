msgstr "Renomear"

#: src/Admin/DocumentMetaBox.php:359
msgid ""
"Renaming is only possible until the signature request is created. Assinafy "
"folds accents and replaces unsupported characters."
msgstr ""
"Só é possível renomear até a solicitação de assinatura ser criada. O "
"Assinafy remove os acentos e substitui os caracteres não suportados."

#: src/Admin/DocumentMetaBox.php:374
msgid "New deadline"
msgstr "Novo prazo"

#: src/Admin/DocumentMetaBox.php:384
msgid "Move deadline"
msgstr "Alterar prazo"

